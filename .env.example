# 1. Telegram: Obtén el token con @BotFather
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Seguridad: Tu ID numérico de Telegram (para que solo tú lo uses). Obténlo en @userinfobot
ALLOWED_USER_ID=123456789

# 3. DeepSeek: Tu API Key de https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. GitHub: Token clásico con permiso 'repo' (https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 5. Repositorio donde está tu bóveda de Obsidian
GITHUB_REPO=tu_usuario/tu-repo-obsidian

# 6. Carpeta dentro de Obsidian donde se guardarán las notas (por defecto: Obsesiones)
NOTES_FOLDER=Obsesiones
